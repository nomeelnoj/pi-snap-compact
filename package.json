{
	"name": "@nomeelnoj/pi-snap-compact",
	"version": "0.1.0",
	"description": "Deterministic bitmap-frame context compaction for vision-capable models in pi — no LLM summarization call",
	"license": "MIT",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"files": [
		"extensions",
		"src",
		"fonts"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test test/*.test.ts"
	},
	"dependencies": {
		"opentype.js": "^1.3.4"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/opentype.js": "^1.3.10",
		"typescript": "^5.6.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	}
}
